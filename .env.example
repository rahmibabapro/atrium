# Atrium local defaults — copy to .env.local
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SQLite (default) or Postgres
ATRIUM_DB_PATH=./data/atrium.sqlite
# ATRIUM_DATABASE_URL=postgres://atrium:atrium@127.0.0.1:5432/atrium

# Comma-separated Atrium ID user ids that always have admin
# ATRIUM_ADMIN_USER_IDS=

# Trusted game / CLI device bridge
# ATRIUM_GAME_SECRET=
