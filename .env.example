# Atrium local defaults — copy to .env.local
# BETTER_AUTH_SECRET + BETTER_AUTH_URL are required in production (fail-fast).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SQLite (default) or Postgres
ATRIUM_DB_PATH=./data/atrium.sqlite
# ATRIUM_DATABASE_URL=postgres://atrium:atrium@127.0.0.1:5432/atrium

# Comma-separated Atrium ID user ids that always have admin
# ATRIUM_ADMIN_USER_IDS=

# Trusted game / CLI device bridge
# ATRIUM_GAME_SECRET=

# Email delivery — pick one (unset = log-only dev mode)
# RESEND_API_KEY=
# ATRIUM_SMTP_URL=smtp://user:pass@smtp.example.com:587
# ATRIUM_EMAIL_FROM="Atrium <no-reply@example.com>"

# Social login — buttons appear automatically when credentials are set
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
