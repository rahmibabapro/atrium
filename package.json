{
  "name": "atrium",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "parity": "node scripts/parity-check.mjs",
    "site:use": "node scripts/use-site.mjs",
    "site:new": "node scripts/new-site.mjs",
    "site:shoe": "node scripts/use-site.mjs shoe-atelier",
    "atriumid:migrate": "pnpm dlx @better-auth/cli@latest migrate --config src/lib/atriumid/auth.ts -y",
    "test:foundation": "tsx --test src/lib/admin/__tests__/page-registry.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/__tests__/*.test.ts\"",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.25",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "kysely": "^0.29.4",
    "next": "^15.4.5",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  },
  "description": "Atrium — forkable foundation for branded community websites (Next.js)."
}
